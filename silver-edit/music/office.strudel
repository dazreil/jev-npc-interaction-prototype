// Vellum & Vine, 4:40 pm. Rain on the mill windows; a warm, tired room.
// Built-in synths only (no samples). Open in Strudel to change it.
// @loop 8
setcps(0.2)
stack(
  // rain: a soft hiss, and drops ticking on the glass
  s("pink").hpf(500).lpf(2200).gain(0.05).pan(sine.range(0.35, 0.65).slow(7)),
  s("white*32").hpf(3500).decay(0.025).sustain(0).gain(rand.range(0, 0.05)).degradeBy(0.55).pan(rand),
  // an old electric piano, slow chords
  note("<[d3,f3,a3,c4] [bb2,d3,f3,a3] [g2,bb2,d3,f3] [a2,c#3,e3,g3]>")
    .s("triangle").attack(0.5).release(2.5).lpf(1300).gain(0.16).room(0.6).size(0.7),
  // a few notes over it, like someone thinking
  note("<~ a4 ~ f4 ~ e4 ~ d4>").s("sine").gain(0.07).delay(0.45).delaytime(0.75).delayfeedback(0.4).room(0.7)
)
