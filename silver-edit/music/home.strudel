// The cottage on Larch Lane, 11:52 pm. Wind, cold rooms, unpacked boxes.
// Built-in synths only (no samples). Open in Strudel to change it.
// @loop 8
setcps(0.18)
stack(
  // wind round the cottage, rising and falling
  s("brown").lpf(sine.range(180, 650).slow(8)).gain(0.13).pan(sine.range(0.3, 0.7).slow(11)),
  // a low, cold pad
  note("<e2 e2 c2 d2>").s("sine").attack(2).release(3).gain(0.14),
  // a few piano-like notes, far apart
  note("<e4 ~ b3 ~ g4 ~ ~ fs4>").s("triangle").decay(1.6).sustain(0).gain(0.11).room(0.9).size(0.9)
)
