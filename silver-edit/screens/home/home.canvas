			"width": 560,
			"height": 360
		},
		{
			"id": "g-art",
			"type": "group",
			"label": "Art: the background, and a prop cut out of green (left to right: make, cut out)",
			"x": -40,
			"y": 520,
			"width": 3000,
			"height": 900,
			"color": "6"
		},
		{
			"id": "home-background",
			"type": "text",
			"x": 700,
			"y": 600,
			"width": 560,
			"height": 340,
			"text": "## home-background\nimage\nstatus: done\nmodel: z-image\nsize: 1280x720\nseed: 21\nprompt: \"a small rented cottage bedroom at night in Vermont, a single lamp, a sensible quilt, red maple leaves pressed against the dark window, seen straight on from a security camera\"\n",
			"color": "4"
		},
		{
			"id": "home-prop",
			"type": "text",
			"x": 700,
			"y": 1000,
			"width": 560,
			"height": 340,
			"text": "## home-prop\nimage\nstatus: idea\nmodel: krea-2\nsize: 768x1024\nseed: 22\nprompt: \"(a prop for this scene), seen straight on\"\n"
		},
		{
			"id": "home-prop-cut",
			"type": "text",
			"x": 1400,
			"y": 1000,
			"width": 520,
			"height": 260,
			"text": "## home-prop-cut\ncutout\nstatus: idea\n# Free: keyed off the green screen. mirror: true also makes a mirror image.\ncrunch: 4\njpeg: 50\n"
		},
		{
			"id": "style-room",
			"type": "text",
			"text": "## fmv-room\nstyle\n# Pre-rendered 1990s CG rooms. Use with model: z-image.\nprefix: A still frame from a 1995 CD-ROM computer game, a pre-rendered 3D CGI background, early 1990s 3D rendering with flat shading, low-polygon models and simple textures\nsuffix: no people, no text or lettering",
			"x": 0,
			"y": 600,
			"width": 520,
			"height": 260,
			"color": "5"
		},
		{
			"id": "krea-prop-green",
			"type": "text",
			"text": "## krea-prop-green\nstyle\n# Krea 2 props to cut out: a filmed 1990s look, flat on, on pure green.\ntemplate: \"A prop for a 1995 CD-ROM full-motion-video game, photographed straight on in a flat front view for chroma-key compositing: {prompt}. Isolated on a solid flat pure green #00FF00 background, evenly lit, no shadow on the background, no ground, no people, no text\"\n",
			"x": 0,
			"y": 1000,
			"width": 560,
			"height": 360,
			"color": "5"
		},
