			"x": 700,
			"y": 600,
			"width": 560,
			"height": 340,
			"text": "## dream-background\nimage\nstatus: done\nmodel: z-image\nsize: 1280x720\nseed: 21\nprompt: \"an endless black velvet void, drifting silk ribbons of shadow, a single cold silver light, surreal and seductive, seen straight on from a security camera\"\n",
			"color": "4"
