			"y": 2000,
			"width": 560,
			"height": 340,
			"text": "## arthur-room\nimage\nstatus: done\nmodel: z-image\nsize: 1024x768\nseed: 11\nprompt: \"a small glass-walled publisher's office at the back of an old converted mill, a heavy oak desk buried in manuscripts and proofs, a green banker's lamp, rain on a tall window behind, red maple leaves outside, nobody in the room\"\n",
			"color": "4"
		},
		{
			"id": "arthur-actor",
			"type": "text",
			"x": 700,
			"y": 2400,
			"width": 560,
			"height": 340,
			"text": "## arthur-actor\nimage\nstatus: done\nmodel: krea-2\nsize: 1024x768\nseed: 12\nprompt: \"Arthur Thorne, publisher of Vellum & Vine, a tall man in his late forties, dark hair greying at the temples, rumpled tweed jacket, tired grief in his eyes, seen waist-up, facing the camera\"\n",
			"color": "4"
		},
		{
