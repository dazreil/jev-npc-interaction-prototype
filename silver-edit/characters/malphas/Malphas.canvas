			"x": 700,
			"y": 2000,
			"width": 560,
			"height": 340,
			"text": "## malphas-room\nimage\nstatus: done\nmodel: z-image\nsize: 1024x768\nseed: 11\nprompt: \"an endless black velvet void, heavy folds of velvet like curtains with no walls, ribbons of dark silk drifting in the air, one cold silver light from above, nobody in the frame\"\n",
			"color": "4"
		},
		{
			"id": "malphas-actor",
			"type": "text",
			"x": 700,
			"y": 2400,
			"width": 560,
			"height": 340,
			"text": "## malphas-actor\nimage\nstatus: done\nmodel: krea-2\nsize: 1024x768\nseed: 12\nprompt: \"Malphas, a tall predatory warlock in his fifties, black hair swept back, a pale sharp face, a black velvet coat, eyes like a starless sky, seen waist-up, facing the camera\"\n",
			"color": "4"
		},
		{
			"id": "malphas-keep",
			"type": "text",
			"x": 0,
			"y": 2800,
			"width": 560,
			"height": 360,
			"text": "## malphas-keep\nstyle\n# Holds Malphas steady in edits: only the named part changes.\ntemplate: \"Keep the person in the reference image exactly as they are: the same identity, hair, clothes, framing, camera position and pose, and the same flat, evenly lit chroma-key green screen background. Change only {prompt}\"\n"
		},
