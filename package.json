{
  "name": "jev-npc-interaction-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/install-espeak-assets.mjs && node scripts/install-piper-assets.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build-static.mjs",
    "start:mock": "python3 -m http.server 5173",
    "test": "node --test tests/*.test.mjs",
    "lint:dialogue": "node scripts/lint-dialogue.mjs",
    "check": "npm test && npm run lint:dialogue",
    "playtest": "node scripts/run-playtests.mjs",
    "evaluate:parity": "node scripts/compare-phase14-baseline.mjs",
    "evaluate:phase14": "npm run check && npm run playtest && npm run evaluate:parity",
    "check:release": "node scripts/check-release.mjs",
    "evaluate:phase15": "npm run check && npm run check:release"
  },
  "dependencies": {
    "@echogarden/espeak-ng-emscripten": "0.3.5"
  },
  "devDependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "onnxruntime-web": "^1.18.0"
  }
}
