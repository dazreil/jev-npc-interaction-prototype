{
  "name": "jev-npc-interaction-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/install-espeak-assets.mjs && node scripts/install-piper-assets.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build-static.mjs",
    "logs:pull": "node scripts/pull-playtest-logs.mjs",
    "start:mock": "python3 -m http.server 5173",
    "test": "node --test tests/*.test.mjs",
    "lint:dialogue": "node scripts/lint-dialogue.mjs",
    "check": "npm test && npm run lint:dialogue && npm run vault:check",
    "playtest": "node scripts/run-playtests.mjs",
    "evaluate:parity": "node scripts/compare-phase14-baseline.mjs",
    "evaluate:phase14": "npm run check && npm run playtest && npm run evaluate:parity",
    "check:release": "node scripts/check-release.mjs",
    "evaluate:phase15": "npm run check && npm run check:release",
    "vault:check": "node scripts/check-vault.mjs",
    "vault:watch": "node scripts/check-vault.mjs --watch",
    "voices:silver": "GAME_VAULT=silver-edit node scripts/voices.mjs",
    "music:silver": "GAME_VAULT=silver-edit node scripts/music.mjs",
    "vault:watch:silver": "GAME_VAULT=silver-edit node scripts/check-vault.mjs --watch",
    "new": "node scripts/new-thing.mjs",
    "vault:compile": "node scripts/compile-vault.mjs",
    "workbench": "node scripts/workbench.mjs",
    "app": "electron desktop/main.mjs",
    "app:silver": "GAME_VAULT=silver-edit electron desktop/main.mjs",
    "workbench:silver": "GAME_VAULT=silver-edit node scripts/workbench.mjs",
    "app:smoke": "ENGINE_SMOKE_TEST=1 electron desktop/main.mjs",
    "assets": "node scripts/assets.mjs",
    "app:install-launcher": "node scripts/install-mac-launcher.mjs"
  },
  "dependencies": {
    "@echogarden/espeak-ng-emscripten": "0.3.5",
    "@vercel/blob": "^2.8.0"
  },
  "devDependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "electron": "^44.5.0",
    "onnxruntime-web": "^1.18.0",
    "yaml": "^2.9.1"
  }
}
