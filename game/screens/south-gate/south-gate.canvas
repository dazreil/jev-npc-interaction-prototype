		{
			"id": "style-room",
			"type": "text",
			"text": "## fmv-room\nstyle\n# Pre-rendered 1990s CG rooms. Use with model: z-image.\nprefix: A still frame from a 1995 CD-ROM computer game, a pre-rendered 3D CGI background, early 1990s 3D rendering with flat shading, low-polygon models and simple textures\nsuffix: no people, no text or lettering",
			"x": 0,
			"y": 1000,
			"width": 520,
			"height": 260,
			"color": "5"
		},
		{
			"id": "car-park-yard",
			"type": "text",
			"text": "## car-park-yard\nimage\nstatus: done\nmodel: z-image\nsize: 1280x720\nseed: 43\nprompt: \"a bleak industrial warehouse yard and staff car park late at night under a heavy overcast sky, seen straight on from the street, nothing in the foreground, the yard starts at the bottom of the frame: wet black asphalt with faded painted bays and puddles, a few parked 1990s cars, a large corrugated metal warehouse with one dim loading bay, a tall concrete guard tower with a single small lit window and a searchlight on the right, chain link fence in the far distance, sparse weak sodium lamps, thin mist, deep shadows, very dark and gloomy, low contrast, cold blue-grey tones\"\n",
			"x": 700,
			"y": 1000,
			"width": 560,
			"height": 300,
			"color": "4"
		},
		{
			"id": "made-car-park-yard-1",
			"type": "file",
			"file": "screens/south-gate/art/car-park-yard/car-park-yard.webp",
			"x": 1340,
			"y": 1000,
			"width": 240,
			"height": 135
		},
		{
			"id": "krea-prop-green",
			"type": "text",
			"text": "## krea-prop-green\nstyle\n# Krea 2 props to cut out: a filmed 1990s look, flat on, on pure green.\ntemplate: \"A prop for a 1995 CD-ROM full-motion-video game, photographed straight on in a flat front view for chroma-key compositing: {prompt}. Isolated on a solid flat pure green #00FF00 background, evenly lit, no shadow on the background, no ground, no people, no text\"\n",
			"x": 0,
			"y": 1460,
			"width": 560,
			"height": 360,
			"color": "5"
		},
		{
			"id": "prop-keep",
			"type": "text",
			"text": "## prop-keep\nstyle\n# Holds a prop steady in edits: only the named part changes.\ntemplate: \"Keep the exact same object, same shape, size, position, framing, materials, colours, lighting and camera quality, and the same solid flat green screen background. {prompt}\"\n",
			"x": 0,
			"y": 1920,
			"width": 560,
			"height": 300,
			"color": "5"
		},
