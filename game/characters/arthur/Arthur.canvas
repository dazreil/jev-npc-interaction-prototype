		{
			"id": "talk-loop",
			"type": "text",
			"text": "## talk-loop\nstyle\n# For mood talking loops: keep the mood, keep the green screen still.\ntemplate: \"The night guard {prompt}, keeping exactly the same expression and mood, small natural mouth and head movements, locked-off static camera, the green screen background stays flat, evenly lit and unchanged\"\n",
			"x": 0,
			"y": 5160,
			"width": 560,
			"height": 320,
			"color": "5"
		},
		{
			"id": "guard-talk",
			"type": "text",
			"text": "## guard-talk\nanimate\nstatus: done\n# Arthur talks on the green screen. The composite pastes every frame.\nmodel: h3-max-turbo\nseconds: 5\nfrom: 0.5\nto: 4.5\nframes: 8\nfps: 8\npingpong: true\nprompt: the night guard talks into the handheld intercom handset with small, natural mouth and head movements, locked-off static camera, the green screen background stays flat, evenly lit and unchanged",
			"x": 700,
			"y": 5160,
			"width": 560,
			"height": 420,
			"color": "4"
		},
